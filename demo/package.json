{
  "name": "ai-weekly",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "description": "AI 周报 —— 采访式个人周复盘工具",
  "author": "AI 周报",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:electron": "node scripts/build-electron.mjs",
    "electron:dev": "npm run build:electron && electron .",
    "pack": "npm run build && npm run build:electron && npm run check:dist && electron-builder --win --dir",
    "dist": "npm run build && npm run build:electron && npm run check:dist && electron-builder --win",
    "check:dist": "node scripts/check-dist.mjs",
    "smoke": "npm run build && npm run build:electron && node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/smoke.mjs --packaged",
    "try:model": "vitest run --config vitest.live.config.ts",
    "icon": "node scripts/make-icon.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
